# TheSocialFox Environment Variables

# Supabase (optional — falls back to local state if not set)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Anthropic API Key (server-side only — used by Vercel serverless functions)
# Set this in Vercel Dashboard > Settings > Environment Variables
# Do NOT prefix with VITE_ — it must stay server-side for security
ANTHROPIC_API_KEY=sk-ant-your-key-here
